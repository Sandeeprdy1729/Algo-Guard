# ─── x402 (from template) ────────────────────────────────────
AVM_ADDRESS=YOUR_ALGORAND_TESTNET_ADDRESS_HERE
FACILITATOR_URL=https://facilitator.goplausible.xyz
PORT=4021

# ─── Algorand ────────────────────────────────────────────────
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_URL=https://testnet-idx.algonode.cloud
POLICY_APP_ID=0
POLICY_APP_ADDRESS=

# ─── AI service ──────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
RISK_MIN_AMOUNT_MICRO=10000   # skip risk scoring below $0.01

# ─── Database (Supabase) ─────────────────────────────────────
# The "%" in a Supabase password MUST be URL-encoded as "%25".
# For Supabase specifically use the transaction pooler URL for runtime
# and the session pooler for prisma migrations.
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# ─── LLM handler + NL policy parser (Groq) ──────────────────
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Admin signer (for on-chain record_spend / freeze / update) ──
# Same wallet that deployed the contract. 25-word Algorand OR
# 12/15/18/21/24-word BIP-39 (Pera Universal Wallet).
ADMIN_MNEMONIC=
ADMIN_ACCOUNT_INDEX=0
