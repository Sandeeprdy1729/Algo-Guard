# ─── x402 (from template) ────────────────────────────────────
AVM_ADDRESS=YOUR_ALGORAND_TESTNET_ADDRESS_HERE
FACILITATOR_URL=https://facilitator.goplausible.xyz
PORT=4021

# ─── Algorand ────────────────────────────────────────────────
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_URL=https://testnet-idx.algonode.cloud
POLICY_APP_ID=0
POLICY_APP_ADDRESS=

# ─── AI service ──────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
RISK_MIN_AMOUNT_MICRO=10000   # skip risk scoring below $0.01

# ─── Database ────────────────────────────────────────────────
# Supabase — the "%" in a Supabase password MUST be URL-encoded as "%25".
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ─── LLM handler ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
