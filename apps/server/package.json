{
  "name": "@agentguard/server",
  "version": "0.1.0",
  "private": true,
  "description": "AgentGuard x402 resource server + policy middleware + dashboard API",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "test": "tsx --test src/policy/engine.test.ts",
    "test:integration": "tsx --test src/app.test.ts",
    "test:all": "tsx --test src/policy/engine.test.ts src/app.test.ts"
  },
  "dependencies": {
    "@algorandfoundation/xhd-wallet-api": "^2.0.0-canary.1",
    "@anthropic-ai/sdk": "^0.32.1",
    "@hono/node-server": "^2.0.2",
    "@prisma/client": "^5.22.0",
    "@x402-avm/extensions": "^2.6.1",
    "@x402/avm": "^2.12.0",
    "@x402/core": "^2.12.0",
    "@x402/hono": "^2.12.0",
    "algosdk": "^3.0.0",
    "bip39": "^3.1.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.19",
    "js-sha512": "^0.8.0",
    "lru-cache": "^11.0.2",
    "tweetnacl": "^1.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.22.0",
    "typescript": "^5.6.3"
  }
}
