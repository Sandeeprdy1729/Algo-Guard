ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=

# Either a 25-word Algorand legacy mnemonic OR a 24-word BIP-39 phrase
# (Pera Universal Wallet). The loader auto-detects by word count.
DEPLOYER_MNEMONIC="twenty five or twenty four word mnemonic here …"

# For BIP-39 wallets only — which HD account index to derive along
# m/44'/283'/{ACCOUNT_INDEX}'/0'/0'. Defaults to 0.
# Ignored when DEPLOYER_MNEMONIC is a legacy 25-word phrase.
ACCOUNT_INDEX=0
